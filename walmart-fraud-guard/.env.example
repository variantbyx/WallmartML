APP_NAME=Walmart Fraud Guard
APP_ENV=production
API_PREFIX=/api/v1

# Authentication
JWT_SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=WalmartFraudGuard
POSTGRES_DSN=postgresql+asyncpg://fraud_user:fraud_pass@postgres:5432/fraud_db
REDIS_URL=redis://redis:6379/0

# ML Model Configuration
MODEL_PATH=ml/artifacts/model.pkl
SCALER_PATH=ml/artifacts/scaler.pkl
MODEL_THRESHOLD=0.75
MODEL_VERSION=xgb-v1

# Rate Limiting & Duplicate Detection
DUPLICATE_TTL_SECONDS=3600
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=10

# LLM Integration (Optional - for SHAP explanations)
OPENAI_API_KEY=sk-your-api-key-here

# Backend CORS
CORS_ORIGINS=http://localhost:3000,http://localhost,https://localhost

# Logging
LOG_LEVEL=INFO
