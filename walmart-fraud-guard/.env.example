APP_NAME=Walmart Fraud Guard
APP_ENV=development
API_PREFIX=/api/v1

MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=WalmartFraudGuard

POSTGRES_DSN=postgresql+asyncpg://fraud_user:fraud_pass@postgres:5432/fraud_db

REDIS_URL=redis://redis:6379/0

MODEL_PATH=ml/artifacts/model.pkl
SCALER_PATH=ml/artifacts/scaler.pkl
MODEL_THRESHOLD=0.75
MODEL_VERSION=xgb-v1

DUPLICATE_TTL_SECONDS=3600
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=10
